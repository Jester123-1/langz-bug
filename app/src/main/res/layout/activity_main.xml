<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9F4E8">

    <LinearLayout
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:text="WELCOME"
                android:textStyle="bold"
                android:textSize="20sp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:textColor="#000000"
                android:background="@drawable/bg_kuning"
                android:layout_centerVertical="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <ImageView
                android:src="@drawable/foto_tengah"
                android:background="#000000"
                android:padding="2dp"
                android:layout_alignParentEnd="true"
                android:layout_width="60dp"
                android:layout_height="60dp"/>
        </RelativeLayout>

        <VideoView
            android:id="@+id/video_animasi"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_kotak"
            android:layout_width="match_parent"
            android:layout_height="220dp"/>

        <ImageView
            android:src="@drawable/foto_tengah"
            android:background="@drawable/bg_kotak"
            android:scaleType="centerCrop"
            android:padding="4dp"
            android:layout_marginTop="-40dp"
            android:layout_width="120dp"
            android:layout_height="120dp"/>

        <TextView
            android:text="INFO MIYABI\nAPK MIYABI AKAN SELALU MEMBERIKAN UPDATE BAGUS DAN BUG WORK. SUPPORT KAMI LEWAT SALURAN WA & TELE."
            android:padding="20dp"
            android:gravity="center"
            android:textSize="12sp"
            android:textColor="#000000"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_kotak"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/btn_login"
            android:text="ENTER TO LOGIN ->"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_biru"
            android:layout_marginTop="20dp"
            android:layout_width="match_parent"
            android:layout_height="60dp"/>

        <LinearLayout
            android:id="@+id/form_input"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <EditText
                android:id="@+id/target"
                android:hint="Nomor target (62xxx)"
                android:inputType="phone"
                android:background="@drawable/bg_kotak"
                android:padding="12dp"
                android:layout_marginTop="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <Button
                android:id="@+id/kirim"
                android:text="EKSEKUSI BUG"
                android:textStyle="bold"
                android:textColor="#000000"
                android:background="@drawable/bg_kuning"
                android:layout_marginTop="20dp"
                android:layout_width="match_parent"
                android:layout_height="60dp"/>
        </LinearLayout>

        <Button
            android:text="APK BUG FREE CLIK"
            android:textStyle="bold"
            android:textColor="#000000"
            android:background="@drawable/bg_kotak"
            android:layout_marginTop="20dp"
            android:layout_width="match_parent"
            android:layout_height="50dp"/>

        <Button
            android:text="HUBUNGI KAMI"
            android:textStyle="bold"
            android:textColor="#000000"
            android:background="@drawable/bg_kuning"
            android:layout_marginTop="20dp"
            android:layout_width="200dp"
            android:layout_height="50dp"/>

    </LinearLayout>
</ScrollView>
