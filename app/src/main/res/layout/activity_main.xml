<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5DC">

    <LinearLayout
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:text="WELCOME"
            android:textStyle="bold"
            android:textSize="24sp"
            android:padding="10dp"
            android:textColor="#000000"
            android:background="#FFD700"
            android:layout_gravity="start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!-- 1. ANIMASI VIDEO DI ATAS -->
        <VideoView
            android:id="@+id/video_animasi"
            android:layout_marginTop="20dp"
            android:layout_width="match_parent"
            android:layout_height="200dp"/>

        <!-- 2. GAMBAR BULAT DI TENGAH -->
        <ImageView
            android:id="@+id/gambar_tengah"
            android:src="@drawable/foto_tengah" 
            android:background="#000000"
            android:padding="5dp"
            android:layout_marginTop="-50dp" 
            android:layout_width="120dp"
            android:layout_height="120dp"/>

        <!-- 3. KOTAK INFO -->
        <TextView
            android:text="INFO MIYABI\nAPK MIYABI AKAN SELALU MEMBERIKAN UPDATE BAGUS DAN BUG WORK."
            android:padding="20dp"
            android:gravity="center"
            android:textSize="14sp"
            android:textColor="#000000"
            android:layout_marginTop="20dp"
            android:background="#FFFFFF"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- Tombol Enter to Login -->
        <Button
            android:id="@+id/btn_login"
            android:text="ENTER TO LOGIN ->"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#007BFF"
            android:layout_marginTop="20dp"
            android:layout_width="match_parent"
            android:layout_height="60dp"/>

        <!-- Form Input (Disembunyiin dulu) -->
        <LinearLayout
            android:id="@+id/form_input"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            
            <EditText
                android:id="@+id/target"
                android:hint="Nomor target (62xxx)"
                android:inputType="phone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <EditText
                android:id="@+id/delay"
                android:hint="Delay (ms)"
                android:inputType="number"
                android:text="50"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <CheckBox
                android:id="@+id/wa_bisnis"
                android:text="WA Business"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <RadioGroup
                android:id="@+id/mode_bug"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RadioButton android:id="@+id/mode_fc" android:text="Force Close" android:checked="true" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <RadioButton android:id="@+id/mode_lock" android:text="Lock Chat" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <RadioButton android:id="@+id/mode_delay" android:text="Delay Hard" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </RadioGroup>

            <Button
                android:id="@+id/kirim"
                android:text="EKSEKUSI BUG"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
